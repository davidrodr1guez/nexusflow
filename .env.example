# ============================================================
# NexusFlow — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# RPC Providers (Alchemy recommended)
ALCHEMY_API_KEY=your_alchemy_api_key
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Deployer wallet (TESTNET ONLY — never use mainnet keys)
PRIVATE_KEY=0x_your_testnet_private_key

# Yellow Network SDK
YELLOW_API_KEY=your_yellow_api_key
YELLOW_ENVIRONMENT=testnet

# LI.FI (optional — free tier available without key)
LIFI_API_KEY=

# Circle / Arc
CIRCLE_API_KEY=your_circle_api_key

# ENS
ENS_NAME=nexusflow.eth

# Agent config
AGENT_TICK_INTERVAL_MS=30000
AGENT_LOG_LEVEL=debug

# Frontend
VITE_ALCHEMY_API_KEY=${ALCHEMY_API_KEY}
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
